<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tito.gitautosync</string>

    <!-- Se invoca python3 DIRECTAMENTE, no /bin/bash: launchd no puede leer
         scripts de shell desde ~/Desktop por el TCC de macOS ("Operation not
         permitted"). Es la misma razón por la que el watcher de forex usa el
         python del venv en vez de un wrapper de shell. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/angel/Desktop/agente-tito-metralleta/web/scripts/git-autosync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/angel/Desktop/agente-tito-metralleta</string>

    <!-- El watcher tiene su propio bucle: se mantiene vivo, no se relanza por
         intervalo. KeepAlive lo resucita si muere. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Si el proceso muere en bucle, no lo relanza más de una vez cada 30 s. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/angel/Desktop/agente-tito-metralleta/web/data/git-autosync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/angel/Desktop/agente-tito-metralleta/web/data/git-autosync.err.log</string>
</dict>
</plist>
