<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tito.gitautosync</string>

    <!-- Se invoca python DIRECTAMENTE, no /bin/bash: launchd no puede leer
         scripts desde ~/Desktop por el TCC de macOS ("Operation not permitted").
         Con /usr/bin/python3 el watcher moría con exit 2 en bucle.

         Este binario de uv es el que TIENE concedido Acceso a Disco Completo, y
         por eso sí puede leer el Desktop. Se apunta a la ruta REAL y no al
         symlink `warren-buffett-jr/engine/.venv/bin/python` que lo alcanza:
         así Tito no depende de que exista el venv del agente de acciones.

         Si algún día falla con "Operation not permitted", la solución limpia es
         conceder Acceso a Disco Completo a /usr/bin/python3 y volver a él. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/angel/.local/share/uv/python/cpython-3.12-macos-aarch64-none/bin/python3.12</string>
        <string>/Users/angel/Desktop/agente-tito-metralleta/web/scripts/git-autosync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/angel/Desktop/agente-tito-metralleta</string>

    <!-- El watcher tiene su propio bucle: se mantiene vivo, no se relanza por
         intervalo. KeepAlive lo resucita si muere. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Si el proceso muere en bucle, no lo relanza más de una vez cada 30 s. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/angel/Desktop/agente-tito-metralleta/web/data/git-autosync.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/angel/Desktop/agente-tito-metralleta/web/data/git-autosync.err.log</string>
</dict>
</plist>
