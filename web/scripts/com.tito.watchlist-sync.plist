<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tito.watchlist-sync</string>

    <!-- NO se invoca /bin/bash directamente: no tiene Acceso a Disco Completo y
         launchd no puede leer el guion desde ~/Desktop (exit 126,
         "Operation not permitted"). Este intérprete de uv sí lo tiene; el
         lanzador lee el .sh y se lo pasa a bash por STDIN. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/angel/.local/share/uv/python/cpython-3.12-macos-aarch64-none/bin/python3.12</string>
        <string>/Users/angel/Proyectos/agente-tito-metralleta/web/scripts/run-watchlist-sync.py</string>
    </array>

    <!-- Sin WorkingDirectory: launchd tampoco podía hacer chdir al Desktop
         ("getcwd: cannot access parent directories"). El cwd lo fija el
         lanzador, que sí tiene permiso. -->

    <!-- Cada 15 min. Con la cola vacia o el servidor apagado el guion sale en
         silencio (exit 0) sin invocar al modelo: coste cero en los pases en vacio. -->
    <key>StartInterval</key>
    <integer>900</integer>

    <!-- Deliberadamente false: el primer pase ocurre a los 15 min, no al cargar,
         para que instalar el job no sea por si mismo una escritura al broker. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/angel/Proyectos/agente-tito-metralleta/web/data/sync-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/angel/Proyectos/agente-tito-metralleta/web/data/sync-launchd.log</string>
</dict>
</plist>
